# Stonks environment variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Vite requires all client-side env vars to be prefixed with VITE_

# DeepSeek API key — enables AI-powered fund analysis in the Banker
# Get your key at: https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_KEY=sk-your-deepseek-api-key

# Production: Cloudflare Worker URL for Yahoo Finance CORS proxy
# Deploy the worker first: npx wrangler deploy --config api-proxy/wrangler.toml
# VITE_YAHOO_PROXY_URL=https://stonks-proxy.francisreubenrbtech25.workers.dev
